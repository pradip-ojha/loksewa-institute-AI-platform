# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/

# ── Celery beat schedule (shelve DB written at runtime) ───────────────────
celerybeat-schedule
celerybeat-schedule-*
celerybeat.pid

# ── Secrets / local env ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Pipeline debug dumps (MCQ_DEBUG_DUMP=1 / KNOWLEDGE_DEBUG_DUMP=1) ─────
# Keep the root folder in git (.gitkeep) but ignore actual dump files.
backend/debug_dumps/mcq/
backend/debug_dumps/knowledge/

# ── Editor / OS ───────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
