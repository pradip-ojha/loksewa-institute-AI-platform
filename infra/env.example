# Copy this file to backend/.env and fill in all values before running.
# Variable names must match backend/app/core/config.py exactly.

# ── Database (Neon managed PostgreSQL — asyncpg driver required) ─────────
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# ── Environment ─────────────────────────────────────────────────────────
# "development" (default) or "production". Production fails closed on insecure config.
ENVIRONMENT=development

# ── Auth ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional shared rate-limit storage (e.g. the Redis URL) for multi-process APIs.
RATELIMIT_STORAGE_URI=

# ── Redis (Upstash managed — rediss:// for TLS) ─────────────────────────
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
# Optional Upstash REST API (only if HTTP-based Redis access is added later)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare R2 ───────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kritipur-valley-demo-bucket
R2_PUBLIC_OR_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_TOKEN_VALUE=

# ── Pinecone (SDK v3+ requires the index host; index must be 3072-dim) ──
PINECONE_API_KEY=
PINECONE_INDEX_NAME=kritipur-valley-demo-index
PINECONE_INDEX_HOST=https://kritipur-valley-demo-index-<id>.svc.<env>.pinecone.io
PINECONE_ENVIRONMENT=
EMBEDDING_DIMENSIONS=3072

# ── Azure OpenAI (primary AI provider for all tasks; no Gemini) ─────────
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION_REASONING=2026-04-24
AZURE_OPENAI_API_VERSION_EMBEDDING=2025-01-01-preview
AZURE_OPENAI_API_VERSION_TRANSCRIPTION=2025-03-01-preview
MODEL_REASONING=gpt-5.5
MODEL_CHAT_THINKING=gpt-5
MODEL_CHAT_FAST=gpt-5-mini
MODEL_EMBEDDING=text-embedding-3-large
MODEL_TRANSCRIPTION=gpt-4o-transcribe
# Semantic-chunking tier (knowledge ingest). One-time per-document cost whose quality
# underpins all retrieval → default gpt-5 ("thinking"); set "fast" for gpt-5-mini.
CHUNKING_MODEL_TIER=thinking

# ── AI / worker timeouts (seconds) ──────────────────────────────────────
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=3
TASK_TIMEOUT_SECONDS=1800

# ── URLs ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Default admin (seeded on first startup) ─────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@neurafix.ai
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Institute Admin
