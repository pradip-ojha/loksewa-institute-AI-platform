# Copy this file to backend/.env and fill in all values before running.

# ── Database (managed PostgreSQL — e.g. Supabase, Neon, Railway, etc.) ──
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Auth ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Redis (managed — e.g. Upstash, Redis Cloud, Railway) ────────────────
REDIS_URL=redis://default:password@host:port

# ── Cloudflare R2 ───────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neurafix-files
R2_PUBLIC_OR_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ── Pinecone ────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=neurafix
PINECONE_ENVIRONMENT=

# ── AI Models ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_TEXT_MODEL=gemini-2.0-flash
DEFAULT_VISION_MODEL=gemini-2.0-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-004
DEFAULT_TRANSCRIPTION_MODEL=

# ── URLs ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Default admin (seeded on first startup) ─────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@neurafix.ai
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=Institute Admin
