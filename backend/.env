

#azure hosted postgres database
PGHOST=neurafix-bridge-database.postgres.database.azure.com
PGUSER=neurafixbridgedbadmin
PGPORT=5432
PGDATABASE=neurafix-loksewa-database
PGPASSWORD=Ppppoza1234@#

# DB connection pool per process (FastAPI + each Celery worker each get their own pool).
# 20/process × 3 processes (API + worker + beat) = 60 total connections to Azure PG.
# Safe for B2s tier (100 max_connections) and higher. Check your tier first:
#   SHOW max_connections;  -- run this on Azure to see the server ceiling.
# Formula: (DB_POOL_SIZE + DB_MAX_OVERFLOW) × num_processes + 10 headroom ≤ max_connections
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12



